---
import '../styles/global.css';
import { categories, navCats } from '../data/site';
interface Props { title: string; description: string; active?: string; }
const { title, description, active } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = navCats.map((s) => categories.find((c) => c.slug === s)!);
---
<!doctype html>
<html lang="da">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="da_DK" />
  <meta property="og:site_name" content="Styrkeviden" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a href="/" class="logo">
        <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#51689b"></rect><path d="M9 21c3 2 11 2 14-1M10 12h12M16 8v13" stroke="#FFFFFF" stroke-width="2.4" fill="none" stroke-linecap="round"></path></svg>
        <span>Styrkeviden</span>
      </a>
      <nav class="nav" aria-label="Hovedmenu">
        {nav.map((c) => <a href={`/${c.slug}/`} aria-current={active === c.slug ? 'page' : undefined}>{c.slug === 'handled' ? 'Håndled' : c.name}</a>)}
        <a href="/om-os/" aria-current={active === 'om-os' ? 'page' : undefined}>Om os</a>
        <a href="/sog/" class="search-link" aria-current={active === 'sog' ? 'page' : undefined}>
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2" fill="none"></circle><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>Søg
        </a>
      </nav>
      <details class="menu">
        <summary aria-label="Åbn menu">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
          <span>Menu</span>
        </summary>
        <nav class="menu-nav" aria-label="Mobilmenu">
        {nav.map((c) => <a href={`/${c.slug}/`} aria-current={active === c.slug ? 'page' : undefined}>{c.slug === 'handled' ? 'Håndled' : c.name}</a>)}
        <a href="/om-os/" aria-current={active === 'om-os' ? 'page' : undefined}>Om os</a>
        <a href="/sog/" class="search-link" aria-current={active === 'sog' ? 'page' : undefined}>
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2" fill="none"></circle><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>Søg
        </a>
              </nav>
      </details>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-about">
        <span class="footer-brand">Styrkeviden</span>
        <span>Udgivet af MakeIt Danmark ApS · CVR 43243985 · Motorgangen 7B, 2690 Karlslunde</span>
        <span>Indholdet er ikke medicinsk rådgivning. Har du smerter, så tal med en fysioterapeut eller læge.</span>
      </div>
      <nav aria-label="Emner">
        <span class="footer-title">Emner</span>
        {categories.map((c) => <a href={`/${c.slug}/`}>{c.name}</a>)}
      </nav>
      <nav aria-label="Om siden">
        <span class="footer-title">Om siden</span>
        <a href="/om-os/">Om os &amp; ejerskab</a>
        <a href="/fagpanel/">Fagpanelet</a>
        <a href="/metode/">Sådan arbejder vi</a>
        <a href="/kontakt/">Kontakt</a>
        <a href="/sog/">Søg</a>
      </nav>
    </div>
  </footer>
</body>
</html>
