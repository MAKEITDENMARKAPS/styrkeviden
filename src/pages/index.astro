---
import Base from '../layouts/Base.astro';
import Ph from '../components/Ph.astro';
import { categories, team, articles, newest, articleBySlug, catBySlug, memberById, articlesIn } from '../data/site';
const guides = newest.map(articleBySlug);
const check = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-10" stroke="#51689b" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---
<Base title="Styrkeviden – viden om styrketræning fra fagfolk" description="Guides om greb, udstyr, teknik og skadesforebyggelse – skrevet og gennemgået af fysioterapeuter, trænere og læger.">
  <section class="wrap hero">
    <div class="hero-text">
      <span class="eyebrow">Viden om styrketræning</span>
      <h1>Træn stærkere med viden fra fagfolk</h1>
      <p class="lead">Guides om greb, udstyr, teknik og skadesforebyggelse – skrevet og gennemgået af fysioterapeuter, trænere og læger, med kilder på alt.</p>
      <form class="search-form" action="/sog/" method="get" role="search">
        <label for="sog" class="sr">Søg i guides</label>
        <input id="sog" name="q" type="search" placeholder="Søg fx “løftestropper” eller “albue”" />
        <button type="submit" class="btn">Søg</button>
      </form>
      <div class="trust">
        <span class="check"><Fragment set:html={check} />Fagligt gennemgået</span>
        <span class="check"><Fragment set:html={check} />Kilder på påstande</span>
        <span class="check"><Fragment set:html={check} />Åbent udgivet af MakeIt</span>
      </div>
    </div>
    <Ph foto="Hero: løfter i dødløft med stropper, naturligt lys" ratio="4 / 3" />
  </section>

  <section class="wrap" style="padding-bottom:64px">
    <div class="section-head">
      <h2>Find den rigtige guide</h2>
      <a href="/emner/" class="more">Se alle emner</a>
    </div>
    <div class="grid grid-cats">
      {categories.map((c) => (
        <a href={`/${c.slug}/`} class="card">
          <span class="card-title">{c.name}</span>
          <span class="card-text">{c.desc}</span>
          <span class="card-meta">{articlesIn(c.slug).length} guides</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-white">
    <div class="wrap">
      <div class="section-head"><h2>Nyeste guides</h2><a href="/emner/" class="more">Alle guides</a></div>
      <div class="grid grid-guides">
        {guides.map((g) => (
          <a href={`/${g.slug}/`} class="guide">
            <Ph foto={g.title} />
            <span class="eyebrow">{catBySlug(g.cat).name}</span>
            <span class="guide-title">{g.title}</span>
            <span class="guide-meta">Af [FAGPERSON], {memberById(g.author).title.toLowerCase()}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="h2" style="margin-bottom:8px">Fagpanelet</h2>
    <p style="margin:0 0 28px;color:var(--muted);max-width:640px">Alle guides skrives eller gennemgås af en fagperson. Skribenterne honoreres af MakeIt for deres arbejde.</p>
    <div class="grid grid-team">
      {team.map((t) => (
        <a href={`/fagpanel/#${t.id}`} class="person">
          <div class="avatar"></div>
          <div><span class="person-name">[FAGPERSON]</span><span class="person-title">{t.title}</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap" style="padding-bottom:72px">
    <div class="band">
      <div class="band-item">
        <h2>Sådan arbejder vi</h2>
        <p>Styrkeviden udgives af MakeIt Danmark ApS, som selv producerer træningsudstyr. Det står på hver side, så du altid ved, hvem der står bag.</p>
        <a href="/metode/">Læs om vores metode</a>
      </div>
      <div class="band-item"><strong>Fagpersoner skriver</strong><span>Hver guide har en navngiven forfatter og en faglig reviewer.</span></div>
      <div class="band-item"><strong>Kilder på påstande</strong><span>Forskning og producentdata linkes direkte i guiden.</span></div>
      <div class="band-item"><strong>Opdateres løbende</strong><span>Alle ændringer står i en opdateringslog nederst i guiden.</span></div>
    </div>
  </section>
</Base>
